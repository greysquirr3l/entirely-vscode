{
  "name": "entirely-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "description": "Documentation site for the Entirely VS Code extension, deployed to greysquirr3l.github.io/entirely",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "deploy": "bash scripts/deploy-docs.sh",
    "deploy:dry": "bash scripts/deploy-docs.sh --no-push"
