    "liveUrl": "https://greysquirr3l.github.io/entirely/",
    "sourceRepo": "greysquirr3l/entirely-vscode"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.2.8",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0"
  }
}
