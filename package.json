{
  "name": "entirely",
  "publisher": "greysquirr3l",
  "displayName": "Entirely",
  "description": "Entire \u2014 code management for agent-human collaboration: sessions, checkpoints, trails, and review, in the editor.",
  "version": "0.0.1",
  "license": "MIT",
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greysquirr3l/entirely-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/greysquirr3l/entirely-vscode/issues"
  },
  "homepage": "https://github.com/greysquirr3l/entirely-vscode#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers",
    "Git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "entirely",
          "title": "Entirely",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "entirely": [
        {
          "id": "entirely.sessions",
          "name": "Sessions"
        },
        {
          "id": "entirely.sessionDetail",
          "name": "Session"
        },
        {
          "id": "entirely.checkpoints",
          "name": "Checkpoints"
        }
      ],
      "explorer": [
        {
          "id": "entirely.explorerSessions",
          "name": "Entirely Sessions",
          "when": "config.entirely.showSessionsInExplorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "entirely.sessions",
        "contents": "No sessions yet.\nSessions are recorded automatically when an agent runs in a repository that Entire tracks.\n[Refresh](command:entirely.refresh)"
      },
      {
        "view": "entirely.sessionDetail",
        "contents": "Select a session to see its details."
      },
      {
        "view": "entirely.checkpoints",
        "contents": "No checkpoints yet.\nA checkpoint is recorded when agent work is committed, and appears here once it is.\n[Refresh](command:entirely.refresh)"
      },
      {
        "view": "entirely.explorerSessions",
        "contents": "No sessions yet.\nSessions are recorded automatically when an agent runs in a repository that Entire tracks.\n[Refresh](command:entirely.refresh)"
      }
    ],
    "commands": [
      {
        "command": "entirely.refresh",
        "title": "Refresh",
        "category": "Entirely"
      },
      {
        "command": "entirely.showSessions",
        "title": "Show Sessions",
        "category": "Entirely"
      },
      {
        "command": "entirely.openSettings",
        "title": "Open Settings",
        "category": "Entirely"
      },
      {
        "command": "entirely.statusBar",
        "title": "Entirely Status",
        "category": "Entirely"
      },
      {
        "command": "entirely.setUp",
        "title": "Set Up Entire",
        "category": "Entirely"
      },
      {
        "command": "entirely.selectSession",
        "title": "Show Session Details",
        "category": "Entirely"
      },
      {
        "command": "entirely.openCheckpointFile",
        "title": "Open Checkpoint Diff",
        "category": "Entirely"
      },
      {
        "command": "entirely.whyThisLine",
        "title": "Why Does This Line Exist?",
        "category": "Entirely"
      },
      {
        "command": "entirely.explainCheckpoint",
        "title": "Explain Checkpoint",
        "category": "Entirely"
      },
      {
        "command": "entirely.repairTerminalPath",
        "title": "Add the Entire CLI to the Terminal PATH",
        "category": "Entirely"
      }
    ],
    "configuration": {
      "title": "Entirely",
      "properties": {
        "entirely.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `entire` binary. Leave empty to use the built-in discovery order: `entire` on `PATH`, then the documented install locations."
        },
        "entirely.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "How often, in seconds, the extension re-reads the Entire CLI for workspace and session state. Set to `0` to poll only when a command is run."
        },
        "entirely.showSessionsInExplorer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also show the Entirely sessions tree in the Explorer, below the source control views."
        },
        "entirely.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "markdownDescription": "Verbosity of the Entirely output channel. This does not change the log level of the Entire CLI itself."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "entirely.statusBar",
          "when": "false"
        },
        {
          "command": "entirely.selectSession",
          "when": "false"
        },
        {
          "command": "entirely.openCheckpointFile",
          "when": "false"
        },
        {
          "command": "entirely.explainCheckpoint",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "entirely.whyThisLine",
          "group": "1_entirely@1",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "prepublishOnly": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
