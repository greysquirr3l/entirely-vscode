{
  "name": "entirely",
  "publisher": "greysquirr3l",
  "displayName": "Entirely",
  "description": "Entire — code management for agent-human collaboration: sessions, checkpoints, trails, and review, in the editor.",
  "version": "0.1.0",
  "license": "MIT",
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "screenshots": [
    {
      "path": "images/sessions.png",
      "alt": "The Entirely view: the sessions Entire tracks for the repository, with the details of the selected one beside them."
    },
    {
      "path": "images/output.png",
      "alt": "The Entire output channel, showing every CLI invocation the extension made and what it got back."
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/greysquirr3l/entirely-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/greysquirr3l/entirely-vscode/issues"
  },
  "homepage": "https://github.com/greysquirr3l/entirely-vscode#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers",
    "Git"
  ],
  "keywords": [
    "entire",
    "git",
    "ai",
    "agent",
    "history"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "entirely",
          "title": "Entirely",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "entirely": [
        {
          "id": "entirely.sessions",
          "name": "Sessions"
        },
        {
          "id": "entirely.sessionDetail",
          "name": "Session"
        },
        {
          "id": "entirely.checkpoints",
          "name": "Checkpoints"
        },
        {
          "id": "entirely.authentication",
          "name": "Account"
        }
      ],
      "explorer": [
        {
          "id": "entirely.explorerSessions",
          "name": "Entirely Sessions",
          "when": "config.entirely.showSessionsInExplorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "entirely.sessions",
        "contents": "No sessions yet.\nSessions are recorded automatically when an agent runs in a repository that Entire tracks.\n[Refresh](command:entirely.refresh)"
      },
      {
        "view": "entirely.sessionDetail",
        "contents": "Select a session to see its details."
      },
      {
        "view": "entirely.checkpoints",
        "contents": "No checkpoints yet.\nA checkpoint is recorded when agent work is committed, and appears here once it is.\n[Refresh](command:entirely.refresh)",
        "when": "!entirely.checkpointFilterActive"
      },
      {
        "view": "entirely.explorerSessions",
        "contents": "No sessions yet.\nSessions are recorded automatically when an agent runs in a repository that Entire tracks.\n[Refresh](command:entirely.refresh)"
      },
      {
        "view": "entirely.authentication",
        "contents": "Not signed in.\n[Sign in to Entire](command:entirely.signIn)"
      }
    ],
    "commands": [
      {
        "command": "entirely.refresh",
        "title": "Refresh",
        "category": "Entirely"
      },
      {
        "command": "entirely.showSessions",
        "title": "Show Sessions",
        "category": "Entirely"
      },
      {
        "command": "entirely.openSettings",
        "title": "Open Settings",
        "category": "Entirely"
      },
      {
        "command": "entirely.statusBar",
        "title": "Entirely Status",
        "category": "Entirely"
      },
      {
        "command": "entirely.setUp",
        "title": "Set Up Entire",
        "category": "Entirely"
      },
      {
        "command": "entirely.selectSession",
        "title": "Show Session Details",
        "category": "Entirely"
      },
      {
        "command": "entirely.openTranscript",
        "title": "Open Session Transcript",
        "category": "Entirely",
        "icon": "$(go-to-file)"
      },
      {
        "command": "entirely.showOwnSession",
        "title": "Show Only This Workspace's Session",
        "category": "Entirely",
        "icon": "$(filter)"
      },
      {
        "command": "entirely.showAllSessions",
        "title": "Show All Sessions",
        "category": "Entirely",
        "icon": "$(clear-all)"
      },
      {
        "command": "entirely.openCheckpointFile",
        "title": "Open Checkpoint Diff",
        "category": "Entirely"
      },
      {
        "command": "entirely.whyThisLine",
        "title": "Why Does This Line Exist?",
        "category": "Entirely"
      },
      {
        "command": "entirely.stopSession",
        "title": "Stop Session",
        "category": "Entirely"
      },
      {
        "command": "entirely.attachSession",
        "title": "Attach Session to a Commit",
        "category": "Entirely"
      },
      {
        "command": "entirely.adoptSession",
        "title": "Adopt Session from Another Worktree",
        "category": "Entirely"
      },
      {
        "command": "entirely.resumeSession",
        "title": "Resume Session",
        "category": "Entirely"
      },
      {
        "command": "entirely.importHistory",
        "title": "Import Past Agent History as Read-Only Checkpoints",
        "category": "Entirely"
      },
      {
        "command": "entirely.blameFile",
        "title": "Blame This File",
        "category": "Entirely"
      },
      {
        "command": "entirely.clearBlame",
        "title": "Clear Blame",
        "category": "Entirely"
      },
      {
        "command": "entirely.explainCheckpoint",
        "title": "Explain Checkpoint",
        "category": "Entirely"
      },
      {
        "command": "entirely.repairTerminalPath",
        "title": "Add the Entire CLI to the Terminal PATH",
        "category": "Entirely"
      },
      {
        "command": "entirely.checkpointDestination",
        "title": "Check Where Checkpoints Are Uploaded",
        "category": "Entirely"
      },
      {
        "command": "entirely.doctor",
        "title": "Doctor: Copy a Diagnostic Report",
        "category": "Entirely"
      },
      {
        "command": "entirely.signIn",
        "title": "Sign In to Entire",
        "category": "Entirely",
        "icon": "$(sign-in)"
      },
      {
        "command": "entirely.signOut",
        "title": "Sign Out of Entire",
        "category": "Entirely",
        "icon": "$(sign-out)"
      },
      {
        "command": "entirely.dumpCliOutput",
        "title": "Doctor: Show the Last Entire CLI Output",
        "category": "Entirely"
      },
      {
        "command": "entirely.searchCheckpoints",
        "title": "Search Checkpoints",
        "category": "Entirely",
        "icon": "$(search)"
      },
      {
        "command": "entirely.clearCheckpointSearch",
        "title": "Clear Checkpoint Search",
        "category": "Entirely",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Entirely",
      "properties": {
        "entirely.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `entire` binary. Leave empty to use the built-in discovery order: `entire` on `PATH`, then the documented install locations. This can only be set in your user settings, never by a workspace."
        },
        "entirely.cliContext": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The saved `entire` login to act as. Leave empty to follow the login the CLI is using on its own. The name is the one `entire auth contexts` prints, such as `us.auth.entire.io` or `handle@us.auth.entire.io`. This only changes what Entirely does — the CLI keeps the login it would have used in your terminal. This can only be set in your user settings, never by a workspace."
        },
        "entirely.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "How often, in seconds, the extension re-reads the Entire CLI for workspace and session state. Set to `0` to poll only when a command is run."
        },
        "entirely.showSessionsInExplorer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also show the Entirely sessions tree in the Explorer, below the source control views."
        },
        "entirely.minimumCliVersion": {
          "type": "string",
          "default": "0.12.2",
          "scope": "machine",
          "markdownDescription": "The oldest `entire` version whose payloads this extension reads in full. The extension works with an older CLI, but the doctor report warns that some information will be missing. Raise this when the extension starts reading a field the CLI added; lower it when an older CLI turns out to report everything."
        },
        "entirely.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "markdownDescription": "Verbosity of the Entire output channel. This does not change the log level of the Entire CLI itself."
        },
        "entirely.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Say more in the Entire output channel: the exact command line, working directory and exit code of every Entire CLI invocation, and an excerpt of what it produced. Equivalent to setting `entirely.logLevel` to `debug`, and it does not add a second channel."
        },
        "entirely.transcriptTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, to wait for the Entire CLI to hand over a session transcript before giving up. A long session produces a large transcript, so raise this if opening one times out."
        },
        "entirely.lifecycleActionTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, to wait for `entire session stop`, `attach` or `adopt` before giving up. Attaching a session to a pushed commit uploads the transcript, so raise this on a slow connection."
        },
        "entirely.importTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "How long, in seconds, to wait for `entire import` (and its preview) before giving up. An import reads up to a month of an agent's transcripts, so raise this for a large history. A timed-out import can be run again: turns already imported are skipped."
        },
        "entirely.resumeWatchTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, **Entirely: Resume Session** watches the session list for the resumed session to become active before it reports that it did not see one. The resume itself keeps running in its terminal."
        },
        "entirely.blameMaxDecoratedLines": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "markdownDescription": "The longest file, in lines, that **Entirely: Blame This File** draws in the editor. A longer file is still blamed and shown in the panel, but nothing is drawn beside its lines."
        },
        "entirely.searchDebounce": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 3000,
          "markdownDescription": "How long, in milliseconds, to wait after you stop typing in the checkpoint search box before asking the Entire CLI to search. Raise this to send fewer searches while you type."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "entirely.signIn",
          "when": "view == entirely.authentication && !entirely.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "entirely.signOut",
          "when": "view == entirely.authentication && entirely.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showOwnSession",
          "when": "view == entirely.sessions && !entirely.ownSessionOnly",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showAllSessions",
          "when": "view == entirely.sessions && entirely.ownSessionOnly",
          "group": "navigation@1"
        },
        {
          "command": "entirely.searchCheckpoints",
          "when": "view == entirely.checkpoints",
          "group": "navigation@1"
        },
        {
          "command": "entirely.clearCheckpointSearch",
          "when": "view == entirely.checkpoints && entirely.checkpointFilterActive",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "entirely.statusBar",
          "when": "false"
        },
        {
          "command": "entirely.selectSession",
          "when": "false"
        },
        {
          "command": "entirely.openCheckpointFile",
          "when": "false"
        },
        {
          "command": "entirely.explainCheckpoint",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "entirely.whyThisLine",
          "group": "1_entirely@1",
          "when": "editorTextFocus"
        },
        {
          "command": "entirely.blameFile",
          "group": "1_entirely@2",
          "when": "editorTextFocus && resourceScheme == file"
        }
      ],
      "view/item/context": [
        {
          "command": "entirely.openTranscript",
          "when": "view == entirely.sessions && viewItem =~ /^entirely\\.(session|importedSession)$/",
          "group": "inline"
        },
        {
          "command": "entirely.resumeSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@1"
        },
        {
          "command": "entirely.attachSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@2"
        },
        {
          "command": "entirely.adoptSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@3"
        },
        {
          "command": "entirely.stopSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "3_destructive@1"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Entirely reads the Entire CLI, which reports on the repository. In an untrusted workspace the CLI path, the saved login and the refresh interval are ignored, so the workspace cannot choose which binary runs, which account it acts as, or how often the extension polls.",
      "restrictedConfigurations": [
        "entirely.cliPath",
        "entirely.cliContext",
        "entirely.refreshInterval"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "prepublishOnly": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:check": "node scripts/check-package.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "marked": "18.1.2",
    "npm-run-all": "^4.1.5",
    "ovsx": "1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
