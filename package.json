    "configuration": {
      "title": "Entirely",
      "properties": {
        "entirely.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `entire` binary. Leave empty to use the built-in discovery order: `entire` on `PATH`, then the documented install locations. This can only be set in your user settings, never by a workspace."
        },
        "entirely.cliContext": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The saved `entire` login to act as. Leave empty to follow the login the CLI is using on its own. The name is the one `entire auth contexts` prints, such as `us.auth.entire.io` or `handle@us.auth.entire.io`. This only changes what Entirely does — the CLI keeps the login it would have used in your terminal. This can only be set in your user settings, never by a workspace."
        },
        "entirely.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "How often, in seconds, the extension re-reads the Entire CLI for workspace and session state. Set to `0` to poll only when a command is run."
        },
        "entirely.showSessionsInExplorer": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also show the Entirely sessions tree in the Explorer, below the source control views."
        },
        "entirely.minimumCliVersion": {
          "type": "string",
          "default": "0.12.2",
          "scope": "machine",
          "markdownDescription": "The oldest `entire` version whose payloads this extension reads in full. The extension works with an older CLI, but the doctor report warns that some information will be missing. Raise this when the extension starts reading a field the CLI added; lower it when an older CLI turns out to report everything."
        },
        "entirely.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "markdownDescription": "Verbosity of the Entire output channel. This does not change the log level of the Entire CLI itself."
        },
        "entirely.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Say more in the Entire output channel: the exact command line, working directory and exit code of every Entire CLI invocation, and an excerpt of what it produced. Equivalent to setting `entirely.logLevel` to `debug`, and it does not add a second channel."
        },
        "entirely.transcriptTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, to wait for the Entire CLI to hand over a session transcript before giving up. A long session produces a large transcript, so raise this if opening one times out."
        },
        "entirely.editorHookAgent": {
          "type": "string",
          "default": "copilot-cli",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "markdownDescription": "The agent integration whose hook payload layout matches the editor's own agent events (the name `entire agent list` prints). Editor events currently use the Copilot CLI payload format, so only `copilot-cli` can be bridged; other values are reported and not forwarded."
        },
        "entirely.agentLookupCacheSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, to reuse the Entire agent list and hook-file scan for editor events. Install and remove actions refresh it immediately."
        },
        "entirely.lifecycleActionTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, to wait for `entire session stop`, `attach` or `adopt` before giving up. Attaching a session to a pushed commit uploads the transcript, so raise this on a slow connection."
        },
        "entirely.cliDoctorTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "markdownDescription": "How long, in seconds, the doctor report waits for `entire doctor` before it records that the CLI's own checks did not finish. The command only reports; it is never run with a flag that changes anything."
        },
        "entirely.controlPlaneTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 900,
          "markdownDescription": "How long, in seconds, to wait for each call the Control Plane view and its commands make to the Entire CLI: a listing, a change, or an API call. Deleting a repository together with its mirrors waits for the mirrors to go, so raise this for a large one. A change that times out is read back, and reported as done only if the CLI now lists it that way."
        },
        "entirely.activityTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "markdownDescription": "How long, in seconds, the Activity view and **Entirely: Show Recap** wait for `entire activity` and `entire recap`. Both are read from Entire's servers in their static, non-interactive form."
        },
        "entirely.dispatchTimeout": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 1800,
          "markdownDescription": "How long, in seconds, **Entirely: Generate Dispatch** waits for the dispatch to be written. A dispatch written by a local agent can take a few minutes. It is never started again after a timeout."
        },
        "entirely.importTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "How long, in seconds, to wait for `entire import` (and its preview) before giving up. An import reads up to a month of an agent's transcripts, so raise this for a large history. A timed-out import can be run again: turns already imported are skipped."
        },
        "entirely.resumeWatchTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "How long, in seconds, **Entirely: Resume Session** watches the session list for the resumed session to become active before it reports that it did not see one. The resume itself keeps running in its terminal."
        },
        "entirely.blameMaxDecoratedLines": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "markdownDescription": "The longest file, in lines, that **Entirely: Blame This File** draws in the editor. A longer file is still blamed and shown in the panel, but nothing is drawn beside its lines."
        },
        "entirely.searchScope": {
          "type": "string",
          "enum": [
            "repository",
            "all-repositories"
          ],
          "enumDescriptions": [
            "Search only the repository this workspace belongs to.",
            "Search every repository the acting login can see."
          ],
          "default": "repository",
          "markdownDescription": "Where **Entirely: Search Past Work and Code** looks. The Search view always says which scope a search ran in and which login it ran as."
        },
        "entirely.searchDebounce": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 3000,
          "markdownDescription": "How long, in milliseconds, to wait after you stop typing in the checkpoint search box before asking the Entire CLI to search. Raise this to send fewer searches while you type."
        },
        "entirely.pluginTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 1800,
          "markdownDescription": "How long, in seconds, **Entirely: Run Plugin Command** and **Entirely: Install Plugin** wait for the plugin or the download. A plugin runs as the login the extension acts as. It is never started again after a timeout."
        },
        "entirely.mcpServerEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer `entire mcp` to the editor as an MCP server, so the editor's agent can reach Entire. The editor starts and stops the process; Entirely does not write the editor's own MCP configuration. Start it with **Entirely: Start MCP Server**. To add the server to a project's `.mcp.json` for other agents, use the Integrations view."
        },
        "entirely.suggestedPlugins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,40}$"
          },
          "default": [
            "graph",
            "investigate",
            "brain"
          ],
          "markdownDescription": "The Entire plugins the **Integrations** view shows a status for, and the plugin picker offers when none is installed. Each is the part after `entire-` in the plugin's executable name. A name that cannot name a plugin is ignored."
        },
        "entirely.offerIntegrationInstall": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer once per machine to install the suggested Entire plugins that are missing, and once per project to add the Entire MCP server to the project's `.mcp.json`. Turn this off to never be asked; the **Integrations** view still shows the status."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "entirely.refreshIntegrations",
          "when": "view == entirely.integrations",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showActivityCommits",
          "when": "view == entirely.activity && entirely.activityListing != commits",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showActivitySessions",
          "when": "view == entirely.activity && entirely.activityListing == commits",
          "group": "navigation@1"
        },
        {
          "command": "entirely.generateDispatch",
          "when": "view == entirely.activity",
          "group": "navigation@2"
        },
        {
          "command": "entirely.refreshActivity",
          "when": "view == entirely.activity",
          "group": "navigation@3"
        },
        {
          "command": "entirely.signIn",
          "when": "view == entirely.authentication && !entirely.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "entirely.signOut",
          "when": "view == entirely.authentication && entirely.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showOwnSession",
          "when": "view == entirely.sessions && !entirely.ownSessionOnly",
          "group": "navigation@1"
        },
        {
          "command": "entirely.showAllSessions",
          "when": "view == entirely.sessions && entirely.ownSessionOnly",
          "group": "navigation@1"
        },
        {
          "command": "entirely.searchWork",
          "when": "view == entirely.search",
          "group": "navigation@1"
        },
        {
          "command": "entirely.clearSearch",
          "when": "view == entirely.search && entirely.searchActive",
          "group": "navigation@2"
        },
        {
          "command": "entirely.searchCheckpoints",
          "when": "view == entirely.checkpoints",
          "group": "navigation@1"
        },
        {
          "command": "entirely.clearCheckpointSearch",
          "when": "view == entirely.checkpoints && entirely.checkpointFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "entirely.createRepository",
          "when": "view == entirely.controlPlane",
          "group": "navigation@1"
        },
        {
          "command": "entirely.runApiCall",
          "when": "view == entirely.controlPlane",
          "group": "navigation@2"
        },
        {
          "command": "entirely.refreshControlPlane",
          "when": "view == entirely.controlPlane",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "entirely.openSearchResult",
          "when": "false"
        },
        {
          "command": "entirely.statusBar",
          "when": "false"
        },
        {
          "command": "entirely.selectSession",
          "when": "false"
        },
        {
          "command": "entirely.openCheckpointFile",
          "when": "false"
        },
        {
          "command": "entirely.explainCheckpoint",
          "when": "false"
        },
        {
          "command": "entirely.deleteRepository",
          "when": "false"
        },
        {
          "command": "entirely.setRepositoryVisibility",
          "when": "false"
        },
        {
          "command": "entirely.deleteProject",
          "when": "false"
        },
        {
          "command": "entirely.deleteOrganisation",
          "when": "false"
        },
        {
          "command": "entirely.grantAccess",
          "when": "false"
        },
        {
          "command": "entirely.revokeAccess",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "entirely.copyDispatch",
          "when": "resourceScheme == entirely-generated && resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "entirely.whyThisLine",
          "group": "1_entirely@1",
          "when": "editorTextFocus"
        },
        {
          "command": "entirely.blameFile",
          "group": "1_entirely@2",
          "when": "editorTextFocus && resourceScheme == file"
        }
      ],
      "view/item/context": [
        {
          "command": "entirely.installIntegration",
          "when": "view == entirely.integrations && viewItem == entirely.integrationPluginMissing",
          "group": "inline"
        },
        {
          "command": "entirely.enableMcpIntegration",
          "when": "view == entirely.integrations && viewItem == entirely.integrationMcpOff",
          "group": "inline"
        },
        {
          "command": "entirely.addMcpToProject",
          "when": "view == entirely.integrations && viewItem == entirely.integrationMcpConfigAddable",
          "group": "inline"
        },
        {
          "command": "entirely.openTranscript",
          "when": "view == entirely.sessions && viewItem =~ /^entirely\\.(session|importedSession)$/",
          "group": "inline"
        },
        {
          "command": "entirely.resumeSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@1"
        },
        {
          "command": "entirely.attachSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@2"
        },
        {
          "command": "entirely.adoptSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "2_lifecycle@3"
        },
        {
          "command": "entirely.stopSession",
          "when": "view == entirely.sessions && viewItem == entirely.session",
          "group": "3_destructive@1"
        },
        {
          "command": "entirely.createRepository",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpProject",
          "group": "1_manage@1"
        },
        {
          "command": "entirely.grantAccess",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpProject",
          "group": "1_manage@2"
        },
        {
          "command": "entirely.deleteProject",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpProject",
          "group": "3_destructive@1"
        },
        {
          "command": "entirely.setRepositoryVisibility",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpRepository",
          "group": "1_manage@1"
        },
        {
          "command": "entirely.grantAccess",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpRepository",
          "group": "1_manage@2"
        },
        {
          "command": "entirely.deleteRepository",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpRepository",
          "group": "3_destructive@1"
        },
        {
          "command": "entirely.grantAccess",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpOrganisation",
          "group": "1_manage@1"
        },
        {
          "command": "entirely.deleteOrganisation",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpOrganisation",
          "group": "3_destructive@1"
        },
        {
          "command": "entirely.grantAccess",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpAccess",
          "group": "1_manage@1"
        },
        {
          "command": "entirely.revokeAccess",
          "when": "view == entirely.controlPlane && viewItem == entirely.cpGrant",
          "group": "3_destructive@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "entirely.entireMcpServers",
        "label": "Entire"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Entirely reads the Entire CLI, which reports on the repository. In an untrusted workspace the CLI path, the saved login and the refresh interval are ignored, so the workspace cannot choose which binary runs, which account it acts as, or how often the extension polls.",
      "restrictedConfigurations": [
        "entirely.cliPath",
        "entirely.cliContext",
        "entirely.refreshInterval"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "prepublishOnly": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:check": "node scripts/check-package.js",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "marked": "18.1.2",
    "npm-run-all": "^4.1.5",
    "ovsx": "1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
